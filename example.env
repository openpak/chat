# Chat service (block 20130 in ports.md). Copy to .env, fill in, never commit .env.
CHAT_DATABASE_URL=postgres://postgres:test@127.0.0.1:54329/chat?sslmode=disable
CHAT_HTTP_ADDR=127.0.0.1:20130
CHAT_GRPC_ADDR=127.0.0.1:20131
CHAT_METRICS_ADDR=127.0.0.1:20132
# The account core (its gRPC on +1 of its block) and the credential this
# service presents there. Announcements land on the core's event stream.
CHAT_CORE_ADDRESS=127.0.0.1:20001
CHAT_CORE_INTERNAL_KEY=
# What the website and the console adapters must present here.
CHAT_INTERNAL_KEY=
